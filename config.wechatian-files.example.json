{
  "mode": "controlled",
  "data_dir": "~/.taskian",
  "database_path": "~/.taskian/taskian.db",
  "channel": { "type": "wechatian-files" },
  "vault_path": "~/Documents/Obsidian Vault",
  "inbox_dir": "Wechatian",
  "outbox_dir": "Wechatian/outbox",
  "state_path": "~/.taskian/state.json",
  "poll_interval": "10s",
  "skip_existing_on_first_run": true,
  "health": {
    "enabled": true,
    "interval": "5m"
  },
  "agents": {
    "codex": {
      "type": "codex",
      "command": "codex",
      "sandbox": "workspace-write",
      "timeout": "45m"
    }
  },
  "projects": {
    "my-project": {
      "path": "~/work/my-project",
      "allowed_agents": ["codex"]
    }
  }
}
