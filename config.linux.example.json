{
  "mode": "controlled",
  "data_dir": "~/.taskian",
  "database_path": "~/.taskian/taskian.db",
  "channel": {
    "type": "ilink",
    "base_url": "https://ilinkai.weixin.qq.com",
    "state_path": "~/.taskian/ilink.json",
    "channel_version": "taskian/0.4",
    "long_poll_timeout": "35s"
  },
  "max_reply_chars": 6000,
  "max_concurrent_tasks": 2,
  "waiting_user_timeout": "72h",
  "health": {
    "enabled": true,
    "interval": "5m"
  },
  "agents": {
    "codex": {
      "type": "codex",
      "command": "codex",
      "sandbox": "workspace-write",
      "timeout": "45m"
    },
    "cursor": {
      "type": "cursor",
      "command": "agent",
      "timeout": "45m"
    }
  },
  "projects": {
    "my-project": {
      "path": "/srv/code/my-project",
      "allowed_agents": ["codex", "cursor"]
    }
  }
}
